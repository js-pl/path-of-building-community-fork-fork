# The default agent container (docs/agent.md, "The default container"):
# two images from one file, built by `pob agent` (`--target proxy` and
# `--target agent`) from the build context it writes: this file, `allow/`
# and `proxy/` (crates/proxy's source).
#
# The harness versions are pinned here; the images are built locally and
# never update by themselves (`pob agent --rebuild` builds them again).

ARG RUST_IMAGE=docker.io/library/rust:1.97-slim-trixie
ARG DEBIAN_IMAGE=docker.io/library/debian:trixie-slim
ARG NODE_IMAGE=docker.io/library/node:24-trixie-slim

# pob-proxy, std only
FROM ${RUST_IMAGE} AS proxy-build
WORKDIR /src
COPY proxy/ ./
RUN cargo build --release && cp target/release/pob-proxy /pob-proxy

# The proxy: the agent's only way out
FROM ${DEBIAN_IMAGE} AS proxy
COPY --from=proxy-build /pob-proxy /usr/local/bin/pob-proxy
COPY allow/ /etc/pob-proxy/
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/pob-proxy"]

# The harnesses, as the image's non-root user `node` (uid 1000)
FROM ${NODE_IMAGE} AS agent
ARG CLAUDE_CODE_VERSION=2.1.330
ARG CODEX_VERSION=0.171.0
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq less procps python3 ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g --no-fund --no-audit \
        @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
        @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force
# The scratch volume goes on /work, the harness's login volume on /home/node
RUN mkdir -p /work && chown node:node /work
ENV HOME=/home/node \
    HTTPS_PROXY=http://pob-proxy:3128 \
    https_proxy=http://pob-proxy:3128 \
    HTTP_PROXY=http://pob-proxy:3128 \
    http_proxy=http://pob-proxy:3128 \
    NO_PROXY=pob-proxy,localhost,127.0.0.1 \
    no_proxy=pob-proxy,localhost,127.0.0.1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    NPM_CONFIG_UPDATE_NOTIFIER=false
USER node
WORKDIR /work
LABEL org.opencontainers.image.title="pob-agent" \
      org.opencontainers.image.description="Path of Building's default agent container: Claude Code and Codex"
CMD ["bash"]
